# Local environment template — copy to .env and fill in the values.

# ── Local PostgreSQL ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Sectors Financial API (IDX market data) ──────────────────────
# Get a key at https://sectors.app/api (Insider plan required).
# Docs: https://docs.sectors.app/ — v2 only (v1 was discontinued 2026-05-11).
SECTORS_API_KEY=
SECTORS_API_BASE_URL=https://api.sectors.app/v2
# Universe for `npm run db:sync`: curated (34 app companies) | all (full IDX)
SECTORS_UNIVERSE=curated
# Soft per-run credit budget guard for the sync script
SECTORS_DAILY_CREDIT_BUDGET=200
# ── Quota policy: sync only the top-N "potential" companies ──────
# The watchlist is ranked locally (0 credits) from market-intel scores,
# signals and SDG evidence before every sync; only these tickers are pulled.
SECTORS_WATCHLIST_LIMIT=20
# Lifetime credit pool for the plan (the run is refused up-front when its
# estimated cost exceeds what is left).
SECTORS_TOTAL_CREDIT_BUDGET=1000
# Credits spent before per-source accounting existed (research/smoke runs)
SECTORS_CREDITS_ALREADY_USED=10
# Fundamentals older than this many days get refreshed (3 credits each)
SECTORS_FUNDAMENTAL_MAX_AGE_DAYS=30
# Global minimum ms between ANY two Sectors calls (shared pacer). The Insider
# plan rate-limits below ~1500ms even with per-request retries.
SECTORS_MIN_INTERVAL_MS=1500

# ── Gann 432 cycle module (/[lang]/gann) ────────────────────────
# Index whose level series anchors the cycle math. Pulled in <=90-day
# chunks because the API clamps any wider request to the trailing 90 days.
SECTORS_INDEX_CODE=ihsg
# How far back to keep index history. 740 days ≈ 9 credits on first pull.
SECTORS_INDEX_HISTORY_DAYS=740

# ── Segments.ai API (labeling platform — reserved, integration later) ──
# Create a key on your account page at https://segments.ai
SEGMENTS_API_KEY=
SEGMENTS_API_BASE_URL=https://api.segments.ai

# ── Supabase production (fill when deploying) ────────────────────
# Runtime app: POOLED connection (port 6543, pgbouncer)
# e.g. postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DATABASE_URL=
# Migrations (drizzle-kit push): DIRECT connection (port 5432)
DIRECT_URL=
# Optional — only needed if you add Supabase Auth/Storage later:
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
