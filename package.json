{
  "name": "nextjs-postgresql-template",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:sync": "tsx src/db/sync-cli.ts",
    "db:migrate:supabase": "tsx src/db/migrate-to-supabase.ts",
    "db:smoke": "tsx src/db/smoke-sectors.ts",
    "db:smoke:gann": "tsx src/db/smoke-gann.ts",
    "test": "jest --coverage",
    "test:e2e": "playwright test --config playwright-dyad.config.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jest": "29.5.14",
    "dotenv": "17.3.1",
    "driver.js": "^1.9.0",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^13.4.4",
    "jest": "29.7.0",
    "lucide-react": "^1.48.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ts-jest": "29.2.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
