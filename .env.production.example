# Production environment template (e.g. Vercel project settings or .env.production).
# Copy the real values into your hosting provider's env settings — never commit real secrets.

# ── Database: Supabase Postgres ──────────────────────────────────
# The Next.js app reads DATABASE_URL. Point it at Supabase's POOLED connection
# string (port 6543, pgbouncer) so serverless instances don't exhaust
# connections. Project settings → Database → Connection pooling.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Sectors Financial API (IDX market data) ──────────────────────
SECTORS_API_KEY=<your sectors api key>
SECTORS_API_BASE_URL=https://api.sectors.app/v2
SECTORS_UNIVERSE=curated
SECTORS_DAILY_CREDIT_BUDGET=200
# Quota policy: only the top-N locally-ranked companies are synced live
SECTORS_WATCHLIST_LIMIT=20
SECTORS_TOTAL_CREDIT_BUDGET=1000
SECTORS_CREDITS_ALREADY_USED=10
SECTORS_FUNDAMENTAL_MAX_AGE_DAYS=30
SECTORS_MIN_INTERVAL_MS=1500
# Gann 432 cycle module — index series anchor
SECTORS_INDEX_CODE=ihsg
SECTORS_INDEX_HISTORY_DAYS=740

# ── Segments.ai API (reserved for the events-annotation pipeline) ──
SEGMENTS_API_KEY=
SEGMENTS_API_BASE_URL=https://api.segments.ai

# ── Supabase direct connection (migrations only) ─────────────────
# Used by `drizzle-kit push` (db:push). Must be the DIRECT (port 5432)
# connection string — pgbouncer in transaction mode breaks drizzle-kit's
# schema introspection. Project settings → Database → Direct connection.
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Optional Supabase platform keys (Auth/Storage — not used yet) ──
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
# Server-only. Never expose to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=<service role key>
